---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { EMAIL, SCHOLAR_URL, LINKEDIN_URL, ORCID_URL, PROFILE } from '../data/site.js';

const { title, description = '', active = 'home', enPath = '/' } = Astro.props;
const site = 'https://jeongjinkim.com';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content={PROFILE.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={site + enPath} />

    <meta property="og:type" content={enPath === '/' ? 'profile' : 'website'} />
    <meta property="og:site_name" content={PROFILE.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={site + enPath} />
    <meta property="og:image" content={site + '/og-card.png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${PROFILE.name}, ${PROFILE.suffix}, ${PROFILE.roles.join(', ')}, ${PROFILE.affiliation}`} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: PROFILE.name,
      givenName: PROFILE.givenName,
      familyName: PROFILE.familyName,
      honorificSuffix: PROFILE.suffix,
      jobTitle: PROFILE.jobTitle,
      url: site + '/',
      image: site + '/og-card.png',
      email: `mailto:${EMAIL}`,
      knowsAbout: [
        'Industrial and Organizational Psychology',
        'Person-situation interactions',
        'Job attitudes and affect',
        'Work performance behavior',
      ],
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: PROFILE.affiliation,
        department: { '@type': 'Organization', name: PROFILE.department },
        url: PROFILE.affiliationUrl,
      },
      identifier: ORCID_URL,
      sameAs: [ORCID_URL, SCHOLAR_URL, LINKEDIN_URL],
    })} />
    <script is:inline>
      try {
        var s = parseFloat(localStorage.getItem('jk-font-scale'));
        if (s && s >= 0.75 && s <= 1.5 && s !== 1) {
          document.documentElement.style.fontSize = 135 * s + '%';
        }
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
