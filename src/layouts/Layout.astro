---
import Nav from '../components/Nav.astro';
import '../styles/global.css';
const { title = 'JeongJin Kim, Ph.D.' } = Astro.props;
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="JeongJin Kim, Ph.D. — Assistant Professor of Industrial-Organizational Psychology, University of Oklahoma."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="banner">
      <div class="container">
        <h1>JeongJin Kim, Ph.D.</h1>
        <p class="subtitle">
          Assistant Professor of Industrial-Organizational Psychology<br />
          Department of Psychology &middot; The University of Oklahoma
        </p>
      </div>
    </header>
    <Nav path={path} />
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="footer">
      <div class="container">
        Assistant Professor<br />
        Department of Psychology<br />
        The University of Oklahoma<br />
        <a href="mailto:jjkim@ou.edu">jjkim [at] ou [dot] edu</a>
        <div class="copyright">&copy; {new Date().getFullYear()} JeongJin Kim. All rights reserved.</div>
      </div>
    </footer>
  </body>
</html>
