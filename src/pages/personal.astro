---
import Layout from '../layouts/Layout.astro';
const photoCount = 72;
---
<Layout
  title="Personal | JeongJin Kim"
  description="A few personal photos."
  active="personal"
  enPath="/personal/"
>
  <h1 class="page-title serif">Personal</h1>
  <p class="page-intro">A few photos outside of work.</p>
  <div class="photo-grid">
    {Array.from({ length: photoCount }, (_, i) => i + 1).map((n) => (
      <img
        src={`/personal/personal-${String(n).padStart(2, '0')}.jpg`}
        alt="Personal photo"
        loading="lazy"
        decoding="async"
      />
    ))}
  </div>
</Layout>
